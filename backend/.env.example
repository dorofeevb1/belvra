# =============================================================================
# BeautyStyleService Backend — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ---- Django (required) ----
DJANGO_ENV=development          # development | production
DJANGO_DEBUG=True               # True for dev, False for production
DJANGO_SECRET_KEY=              # REQUIRED: generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (required) ----
POSTGRES_DB=beautystyle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # REQUIRED
POSTGRES_HOST=localhost         # Use 'db' for docker-compose
POSTGRES_PORT=5432

# ---- Redis (required) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                 # Leave empty for local dev without auth

# ---- Celery (required) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS (required) ----
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Frontend URL (required — used for email links) ----
FRONTEND_URL=http://localhost:4200

# ---- Email (optional for dev — defaults to console backend) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=                # e.g. your-email@yandex.ru
EMAIL_HOST_PASSWORD=            # App password from email provider
DEFAULT_FROM_EMAIL=BeautyBook <noreply@example.com>

# ---- Security (production) ----
SECURE_SSL_REDIRECT=False       # Set True when behind HTTPS

# ---- YooKassa Payments (optional) ----
# Get credentials from https://yookassa.ru/my/shop-settings
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_SEND_RECEIPT=False

# ---- Payment Settings (optional — defaults are in settings) ----
PAYMENT_RETURN_URL=http://localhost:4200/payment/success
PLATFORM_COMMISSION_RATE=0.05
MIN_COMMISSION=10.00
PROVIDER_FEE_RATE=0.02
PAYMENT_HOLD_DAYS=3
PREPAYMENT_PERCENT=0.20

# ---- Withdrawal Settings (optional) ----
MIN_WITHDRAWAL_AMOUNT=100.00
MIN_AUTO_WITHDRAWAL_AMOUNT=1000.00
