# =============================================================================
# Belvra Backend — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ---- Django (required) ----
DJANGO_ENV=development          # development | production
DJANGO_DEBUG=True               # True for dev, False for production
DJANGO_SECRET_KEY=              # REQUIRED: generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (required) ----
POSTGRES_DB=belvra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # REQUIRED
POSTGRES_HOST=localhost         # Use 'db' for docker-compose
POSTGRES_PORT=5432

# ---- Redis (required) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                 # Leave empty for local dev without auth

# ---- Celery (required) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS (required) ----
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Frontend URL (required — used for email links) ----
FRONTEND_URL=http://localhost:4200

# ---- Email (optional for dev — defaults to console backend) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=                # e.g. your-email@yandex.ru
EMAIL_HOST_PASSWORD=            # App password from email provider
DEFAULT_FROM_EMAIL=Belvra <noreply@example.com>

# ---- Security (production) ----
SECURE_SSL_REDIRECT=False       # Set True when behind HTTPS

# ---- T-Bank Payments (подписки мастеров) ----
# Получите ключи на https://developer.tbank.ru/
# Для тестирования используйте DEMO-терминал
TBANK_TERMINAL_KEY=              # e.g. 1774615155386DEMO
TBANK_PASSWORD=                  # e.g. cAk9hZfCjw6b3gqu
TBANK_SEND_RECEIPT=false         # true для отправки чеков по ФЗ-54
TBANK_TAXATION=usn_income        # Система налогообложения (osn, usn_income, usn_income_outcome, patent)
TBANK_API_URL=https://securepay.tinkoff.ru/v2/

# Notification URL (указать в личном кабинете T-Business):
# https://your-domain.com/api/v1/subscriptions/webhook/

# ---- Firebase Push Notifications (optional) ----
FIREBASE_CREDENTIALS_PATH=           # Path to firebase-credentials.json (download from Firebase Console)

# ---- AI (optional) ----
PERPLEXITY_API_KEY=              # API key from Perplexity
OLLAMA_URL=http://localhost:11434  # Ollama server URL

# ---- Logging ----
DJANGO_LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
