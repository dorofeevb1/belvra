{
  "name": "belvra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Belvra - Web and Mobile Applications",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w @belvra/web",
    "web:build": "npm run build -w @belvra/web",
    "mobile:dev": "npm run dev -w @belvra/mobile",
    "mobile:build": "npm run build -w @belvra/mobile",
    "mobile:sync": "npm run sync -w @belvra/mobile",
    "shared:build": "npm run build -w @belvra/shared",
    "build": "npm run build:prod -w @belvra/mobile",
    "ionic:build": "npm run build:prod -w @belvra/mobile",
    "ionic:capacitor:build": "npm run build:prod -w @belvra/mobile"
  },
  "dependencies": {
    "@capacitor/ios": "^7.2.0",
    "@capacitor/android": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
