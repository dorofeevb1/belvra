# Django
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=beautystyle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# Email (production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@beautystyle.com
