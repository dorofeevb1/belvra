# =============================================================================
# BeautyStyleService — Root Environment Variables (docker-compose)
# Copy this file to .env and fill in the values
# Used by: docker-compose.dev.yml / docker-compose.prod.yml
# =============================================================================

# ---- Django (required) ----
DJANGO_ENV=development          # development | production
DJANGO_DEBUG=True               # True for dev, False for production
DJANGO_SECRET_KEY=              # REQUIRED: generate a strong random key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (required) ----
POSTGRES_DB=beautystyle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # REQUIRED: set a strong password

# ---- Redis (required) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                 # REQUIRED for production; leave empty for local dev

# ---- Celery (required) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS (required) ----
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# ---- Frontend URL (required — used for email links) ----
FRONTEND_URL=http://localhost:4200

# ---- Email (optional for dev) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=                # e.g. your-email@yandex.ru
EMAIL_HOST_PASSWORD=            # App password from email provider
DEFAULT_FROM_EMAIL=BeautyBook <noreply@example.com>

# ---- Security (production) ----
SECURE_SSL_REDIRECT=False       # Set True when behind HTTPS

# ---- YooKassa Payments (optional) ----
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
